{:paths ["src"]

 ;; Outbound connections are provided by the portable jolt-tcp client. Its
 ;; transitive jolt-net dependency owns the runtime-specific native bindings.
 :deps {io.github.casselc/jolt-bencode
        {:git/url "https://github.com/casselc/jolt-bencode.git"
         :git/sha "17858cdbdbe1287cd9be10437549a8d3d72bb554"}

        io.github.casselc/jolt-tcp
        {:git/url "https://github.com/casselc/jolt-tcp.git"
         :git/sha "911cf783d56e988adb2b8f716b6636fae5454e52"}}

 ;; This library's server middleware (sessions, interruptible-eval, completion,
 ;; lookup) — jolt.nrepl composes them over its built-in handler. A consuming
 ;; project adds this lib and copies this line; declared here so `jolt nrepl` in
 ;; this repo serves the full stack.
 :nrepl/middleware [nrepl.middleware/default-middleware]

 :aliases
 {:test
  {:extra-paths ["test"]
   :main-opts ["-m" "nrepl.test-runner"]}

  :jvm-bencode-test
  {:extra-paths ["test"]
   :extra-deps
   {org.clojure/clojure {:mvn/version "1.12.2"}}
   :main-opts ["-m" "nrepl.bencode-test-runner" "jvm"]}

  ;; Dependency-free codec coverage. This still resolves the public dependency
  ;; graph, but deliberately loads only the bencode/bytes layers.
  :portable-test
  {:extra-paths ["test"]
   :main-opts ["-m" "nrepl.bencode-test-runner" "jolt"]}

  :hegel
  {:extra-paths ["test/hegel"]
   :extra-deps
   {io.github.chucklehead-dev/jolt-hegel
    {:git/url "https://github.com/chucklehead-dev/jolt-hegel.git"
     :git/sha "c406e6a85e9902dd89a42a3abce3d6161e5cd406"}}
   :main-opts ["-m" "nrepl.transport-hegel-runner"]}}

 :tasks
 {test "jolt -M:test"
  test-bencode-jvm "clojure -Srepro -M:jvm-bencode-test"
  test-portable "jolt -M:portable-test"
  setup-hegel "jolt -A:hegel -m hegel.install"
  test-hegel "jolt -M:hegel"}}
